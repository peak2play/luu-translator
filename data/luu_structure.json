// ======================================
// Luu Translator
// Rule Engine Version 2.0
// ======================================


let luuRules = [];


// โหลดกฎ

async function loadRules(){

    try{

        const response =
            await fetch(
                "data/luu_structure.json"
            );


        const data =
            await response.json();


        luuRules =
            data.rules.sort(
                (a,b)=>
                a.priority-b.priority
            );


        console.log(
            "Luu Rule Loaded"
        );


    }catch(error){

        console.error(
            "Load Rule Error",
            error
        );

    }

}


loadRules();





// ======================================
// Main Translate
// ======================================


async function translateLuu(){


    if(luuRules.length===0){

        await loadRules();

    }


    const input =
        document
        .getElementById("thaiInput")
        .value
        .trim();



    if(!input){

        document
        .getElementById("result")
        .innerText="";

        return;

    }



    const result =
        translateSentence(input);



    document
    .getElementById("result")
    .innerText=result;


}






// ======================================
// แปลทั้งประโยค
// ======================================


function translateSentence(sentence){


    let words =
        sentence.split(/\s+/);



    return words
    .map(word=>{

        return translateWord(word);

    })
    .join(" ");

}





// ======================================
// แปลคำ
// ======================================


function translateWord(word){


    // แยกพยางค์เบื้องต้น

    let syllables =
        splitThaiSyllable(word);



    return syllables
    .map(
        s =>
        translateSyllable(s)
    )
    .join("");

}






// ======================================
// แยกพยางค์เบื้องต้น
// ======================================


function splitThaiSyllable(word){


    /*
        Prototype

        ตัวเต็มจะเพิ่ม
        Thai syllable analyzer

    */


    return [word];

}






// ======================================
// แปลงพยางค์
// ======================================


function translateSyllable(syllable){



    let rule =
        findRule(syllable);



    if(!rule){

        return syllable;

    }



    return applyRule(
        syllable,
        rule
    );

}





// ======================================
// เลือก Rule
// ======================================


function findRule(word){


    for(
        let rule of luuRules
    ){


        let c =
            rule.condition;



        // ร ล + อุ อู

        if(
            c.has_rl &&
            c.has_u_vowel &&
            hasRL(word) &&
            hasUVowel(word)
        ){

            return rule;

        }





        // อุ อู

        if(
            c.has_u_vowel &&
            hasUVowel(word)
        ){

            return rule;

        }





        // ร ล

        if(
            c.has_rl &&
            hasRL(word)
        ){

            return rule;

        }





        // default

        if(
            c.default
        ){

            return rule;

        }


    }



    return null;

}







// ======================================
// ตรวจ ร ล
// ======================================


function hasRL(word){

    return /[รล]/.test(word);

}





// ======================================
// ตรวจ อุ อู
// ======================================


function hasUVowel(word){

    return /[ุู]/.test(word);

}





// ======================================
// Apply Rule
// ======================================


function applyRule(word,rule){



    let first =
        word.charAt(0);



    let rest =
        word.substring(1);




    let newFirst =
        rule.transform
        .replace_initial;




    let firstPart =
        newFirst + rest;





    let length =
        checkVowelLength(word);





    let addVowel =
        getAddVowel(
            rule,
            length
        );





    let secondPart =
        first +
        addVowel +
        getFinal(word);





    return firstPart + secondPart;


}







// ======================================
// ตรวจเสียงสั้น/ยาว
// ======================================


function checkVowelLength(word){


    const longVowel =
    [
        "า",
        "ี",
        "ื",
        "ู",
        "เ",
        "แ",
        "โ",
        "อ",
        "เอีย",
        "เอือ",
        "อัว"
    ];



    for(
        let v of longVowel
    ){

        if(
            word.includes(v)
        ){

            return "long";

        }

    }


    return "short";


}







// ======================================
// เลือกสระเติม
// ======================================


function getAddVowel(rule,type){



    if(type==="long"){

        return rule
        .transform
        .added_vowel
        .long;

    }



    return rule
    .transform
    .added_vowel
    .short;


}






// ======================================
// หาเสียงท้าย
// ======================================


function getFinal(word){


    const finals =
    [
        "ก",
        "ข",
        "ค",
        "ง",
        "ด",
        "ต",
        "น",
        "ม",
        "ย",
        "ว",
        "บ",
        "ป"
    ];



    for(
        let f of finals
    ){

        if(
            word.endsWith(f)
        ){

            return f;

        }

    }



    return "";

}







// ======================================
// Paste
// ======================================


async function pasteText(){


    let text =
        await navigator.clipboard
        .readText();



    document
    .getElementById("thaiInput")
    .value=text;


}







// ======================================
// Clear
// ======================================


function clearText(){


    document
    .getElementById("thaiInput")
    .value="";


    document
    .getElementById("result")
    .innerText="";


}







// ======================================
// Copy
// ======================================


function copyResult(){


    let text =
        document
        .getElementById("result")
        .innerText;



    navigator.clipboard
    .writeText(text);


}
